# ===============================================
# EMPOWER PRODUCTION ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env and fill in production values
# chmod 600 .env after creation for security
# ===============================================

# -----------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------
APP_NAME="Empower Investment Club"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-production-domain.com

# -----------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=empower_db_production
DB_USERNAME=empower_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Password Requirements:
# - Minimum 20 characters
# - Mix of uppercase, lowercase, numbers, symbols
# - No dictionary words
# Example generator: openssl rand -base64 32

# -----------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------
SESSION_LIFETIME=7200
# Session lifetime in seconds (7200 = 2 hours)
# Adjust based on security vs convenience needs

CSRF_PROTECTION=true
# NEVER disable this in production

# -----------------------------------------------
# TIMEZONE
# -----------------------------------------------
APP_TIMEZONE=Africa/Nairobi
# Kenya timezone for all date/time operations

# -----------------------------------------------
# MAIL CONFIGURATION (SMTP)
# -----------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Empower Investment Club"

# Gmail App Password Instructions:
# 1. Enable 2FA on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate app password for "Mail"
# 4. Use that 16-character password (no spaces)

# Alternative SMTP Providers:
# - SendGrid: smtp.sendgrid.net (Port 587)
# - Mailgun: smtp.mailgun.org (Port 587)
# - AWS SES: email-smtp.region.amazonaws.com (Port 587)

# -----------------------------------------------
# PUSH NOTIFICATIONS (Optional)
# -----------------------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# OneSignal Setup:
# 1. Create account at https://onesignal.com
# 2. Create new app
# 3. Get App ID from Settings → Keys & IDs
# 4. Get REST API Key from same page

# Leave empty to disable push notifications

# -----------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------
MAX_UPLOAD_SIZE=5242880
# Maximum file upload size in bytes (5MB default)
# Must match php.ini upload_max_filesize and post_max_size

ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
# Comma-separated list of allowed extensions
# No spaces, lowercase only

# -----------------------------------------------
# FINANCIAL YEAR SETTINGS
# -----------------------------------------------
# These are informational - actual FY created in system
FINANCIAL_YEAR_START_MONTH=5
# 5 = May (financial year runs May 1 - April 30)

FINANCIAL_YEAR_END_MONTH=4
# 4 = April

# -----------------------------------------------
# LOGGING
# -----------------------------------------------
LOG_LEVEL=error
# Options: debug, info, warning, error
# Use 'error' in production, 'debug' only for troubleshooting

LOG_PATH=app/logs
# Directory for application logs (relative to project root)
# Ensure this directory exists and is writable

# -----------------------------------------------
# BACKUP SETTINGS
# -----------------------------------------------
BACKUP_PATH=/backups/empower
# Full path to backup directory
# Must be outside web root
# Ensure adequate disk space (recommend 10GB+)

BACKUP_RETENTION_DAYS=30
# Number of days to keep automatic backups

# -----------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------
CACHE_ENABLED=true
# Enable application-level caching

CACHE_LIFETIME=3600
# Cache lifetime in seconds (1 hour)

QUERY_CACHE_ENABLED=true
# Enable database query result caching

# -----------------------------------------------
# SECURITY HEADERS
# -----------------------------------------------
ENABLE_HSTS=true
# HTTP Strict Transport Security
# Forces HTTPS for all requests

HSTS_MAX_AGE=31536000
# HSTS max age in seconds (1 year)

# -----------------------------------------------
# RATE LIMITING (Optional)
# -----------------------------------------------
RATE_LIMIT_ENABLED=false
# Enable rate limiting for API endpoints

RATE_LIMIT_REQUESTS=100
# Maximum requests per time window

RATE_LIMIT_WINDOW=60
# Time window in seconds

# -----------------------------------------------
# MAINTENANCE MODE
# -----------------------------------------------
MAINTENANCE_MODE=false
# Set to true to enable maintenance mode
# Users will see maintenance page

MAINTENANCE_MESSAGE="System maintenance in progress. Please check back shortly."
# Custom message for maintenance page

MAINTENANCE_ALLOWED_IPS=127.0.0.1
# Comma-separated IPs that can access during maintenance

# -----------------------------------------------
# MONITORING & ALERTING (Optional)
# -----------------------------------------------
ALERT_EMAIL=admin@yourdomain.com
# Email for critical system alerts

MONITOR_DISK_SPACE=true
# Alert when disk space below threshold

DISK_SPACE_THRESHOLD=90
# Alert when disk usage exceeds this percentage

MONITOR_DATABASE_SIZE=true
# Alert when database size exceeds threshold

DATABASE_SIZE_THRESHOLD_MB=1000
# Alert when database exceeds this size (MB)

# -----------------------------------------------
# DEVELOPMENT/STAGING OVERRIDES
# -----------------------------------------------
# These should ONLY be used in dev/staging
# NEVER enable in production

# DEV_ALLOW_WEAK_PASSWORD=false
# DEV_SKIP_EMAIL_VERIFICATION=false
# DEV_SHOW_SQL_QUERIES=false
# DEV_DISABLE_RATE_LIMITS=false

# ===============================================
# END OF CONFIGURATION
# ===============================================

# SECURITY CHECKLIST BEFORE GOING LIVE:
# [ ] All passwords changed from defaults
# [ ] APP_ENV set to 'production'
# [ ] APP_DEBUG set to false
# [ ] Database credentials are strong (20+ chars)
# [ ] SMTP credentials configured and tested
# [ ] .env file permissions set to 600
# [ ] .env file is NOT in git (.gitignore verified)
# [ ] HTTPS certificate installed and working
# [ ] Backup system configured and tested
# [ ] Error logging tested and working
# [ ] All IP addresses updated for production
# [ ] Firewall rules configured
# [ ] Database user has minimal required privileges

# POST-DEPLOYMENT VERIFICATION:
# [ ] Test login system
# [ ] Test transaction posting
# [ ] Verify journal entries created
# [ ] Check trial balance
# [ ] Test email sending
# [ ] Verify backups running
# [ ] Check error logs
# [ ] Monitor system performance
