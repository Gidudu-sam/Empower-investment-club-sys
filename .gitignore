# Composer-managed dependencies — regenerate via `composer install`
# using the committed composer.lock. Never commit vendor/ itself.
/vendor/

# Historical/operational backups — contain real historical SQL dumps.
# These live in the project folder for local operational convenience but
# must never be pushed to a remote repository.
/backups/
/database/backups/

# Audit trail and generated reports — large, historical, not application
# source. Kept locally; excluded from version control per project decision
# (2026-09-10) to keep the repository focused on the live codebase.
/results/

# Editor/tool-local artifacts — not part of the application.
/.history/
/.claude/

# One-time historical recovery/reorganization artifacts and their
